.container{
    display:grid;
    grid-template-columns:38% 60%;
    gap:20px;
    padding:20px;
}

.card{
    background:white;
    padding:20px;
    border-radius:12px;
    box-shadow:0px 3px 10px rgba(0,0,0,.2);
