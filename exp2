    margin-top:10px;
    font-weight:bold;
}

input,select,textarea{
    width:100%;
    padding:8px;
    margin-top:5px;
    border:1px solid #999;
    border-radius:5px;
}

textarea{
    resize:none;
}

input[type=radio],
input[type=checkbox]{
    width:auto;
}

button{
    background:#1565c0;
    color:white;
    border:none;
    padding:10px 20px;
    margin-top:15px;
    border-radius:5px;
    cursor:pointer;
}

button:hover{
    background:#0b3c6f;
}

img{
    width:220px;
    height:220px;
    border-radius:50%;
    display:block;
    margin:auto;
    object-fit:cover;
    border:5px solid #1976d2;
}

video,
audio,
embed,
iframe{
    width:100%;
    border-radius:8px;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
}

table,th,td{
    border:1px solid #666;
}

th{
    background:#1976d2;
    color:white;
}

th,td{
    padding:10px;
    text-align:center;
}

progress{
    width:100%;
    height:22px;
}

footer{
    background:#0b3c6f;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}
</style>

