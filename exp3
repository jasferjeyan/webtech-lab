<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Book Store - Responsive Webpage</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#f4f4f4;
}

/* Header */
header{
    background:#4a2c2a;
    color:white;
    text-align:center;
    padding:20px;
}

header h1{
    font-size:40px;
    letter-spacing:3px;
    text-shadow:2px 2px 5px black;
}

header p{
    font-style:italic;
}

/* Navigation */
nav{
    background:#8b5e3c;
    padding:15px;
    text-align:center;
}

nav a{
    color:white;
    text-decoration:none;
    margin:15px;
    padding:8px 15px;
}

nav a:link{
    color:white;
}

nav a:visited{
    color:#ffe082;
}

nav a:hover{
    background:#ffd54f;
    color:black;
    border-radius:5px;
}

nav a:active{
    background:red;
    color:white;
}

/* Banner */
.banner{
    background:url("https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=1200") no-repeat center;
    background-size:cover;
    color:white;
    text-align:center;
    padding:80px;
}

.banner h2{
    font-size:40px;
}

.banner p{
    font-size:20px;
}

/* About */
.about{
    margin:30px;
    padding:20px;
    background:white;
    border-radius:10px;
}

.about h2{
    color:#4a2c2a;
    text-decoration:underline;
    margin-bottom:10px;
}

/* Books */
.books{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:20px;
    margin:20px;
}

.book{
    background:white;
    width:250px;
    padding:15px;
    border-radius:10px;
    box-shadow:0 4px 10px gray;
    text-align:center;
}

.book img{
    width:180px;
    height:250px;
}

.book h3{
    color:#4a2c2a;
    margin:10px 0;
}

.book p{
    margin:5px;
}

.book button{
    background:#4a2c2a;
    color:white;
    padding:10px 20px;
    border:none;
    cursor:pointer;
}

.book button:hover{
    background:#ff9800;
}

/* Categories */
.categories{
    background:#fff;
    margin:30px;
    padding:20px;
}

.categories ul{
    list-style-type:circle;
    margin-left:30px;
}

/* Offer */
.offer{
    background:#ffe082;
    margin:30px;
    padding:30px;
    text-align:center;
    font-size:22px;
    font-weight:bold;
}

/* Contact */
.contact{
    margin:30px;
    padding:20px;
    background:white;
}

.contact h2{
    margin-bottom:10px;
}

/* Footer */
footer{
    background:#4a2c2a;
    color:white;
    text-align:center;
    padding:20px;
}

/* Responsive */
@media(max-width:768px){

.books{
flex-direction:column;
align-items:center;
}

.banner{
padding:50px;
}

header h1{
font-size:28px;
}

}
</style>

</head>

<body>

<header>
<h1>BOOK HAVEN</h1>
<p>Your Favourite Online Book Store</p>
</header>

<nav>
<a href="#">Home</a>
