    <p>
    Heads Total: <span id="num_heads">0</span><br>
    Tails Total: <span id="num_tails">0</span>
    </p>
    <script>
        let heads = 0;
        let tails = 0;
        document.getElementById("flip").addEventListener("click", flipFunction);
        function flipFunction() {
            let random = Math.floor(Math.random() * 2);
            if (random == 0) {
                document.getElementById("coin").src = "c:\\Users\\jasfe\\Downloads\\2887-original.jpg";
                heads++;
            }
            else {
                document.getElementById("coin").src = "c:\\Users\\jasfe\\Downloads\\images (1).jpg";
                tails++;
            }
            document.getElementById("num_heads").innerHTML = heads;
            document.getElementById("num_tails").innerHTML = tails;
        }
    </script>
</body>
</html>
