<!DOCTYPE html>
<html>
<head>
    <title>Shortest and Longest Word - URK24CS1175</title>
</head>
<body>
    <h2>Find Shortest and Longest Word - URK24CS1175</h2>
    <button onclick="findwords()">Find</button>
    <p id="result"></p>

    <script>
        function findwords() {
            var str = "Web Development Tutorial";
            var words = str.split(" ");
            var shortest = words[0];
            var longest = words[0];

            for (var i = 0; i < words.length; i++) {
                if (words[i].length < shortest.length) {
                    shortest = words[i];
                }
                if (words[i].length > longest.length) {
                    longest = words[i];
                }
            }

            document.getElementById("result").innerHTML = 
                "Shortest: " + shortest + "<br>" + 
                "Longest: " + longest;
        }
    </script>
</body>
</html>



<!DOCTYPE html>
<html>
<head>
    <title>BMI Calculator - URK24CS1175</title>
</head>
<body>
    <h2>BMI Calculator - URK24CS1175</h2>
    Weight (kg):
    <input type="text" id="weight">
    <br><br>
    Height (cm):
    <input type="text" id="height">
    <br><br>
    <button onclick="calculate()">Get BMI</button>
    <p>
    The BMI is : <span id="score"></span>
    <br>
    The Body Type is : <span id="type"></span>
    </p>
    <script>
        function calculate() {
            var weight = parseFloat(document.getElementById("weight").value);
            var height = parseFloat(document.getElementById("height").value);
            height = height / 100;
            var bmi = weight / (height * height);
            document.getElementById("score").innerHTML = bmi.toFixed(2);
            if (bmi < 18) {
                document.getElementById("type").innerHTML = "Underweight";
            }
            else if (bmi < 25) {
                document.getElementById("type").innerHTML = "Normal";
            }
            else if (bmi < 30) {
                document.getElementById("type").innerHTML = "Overweight";
            }
            else {
                document.getElementById("type").innerHTML = "Obese";
            }
        }
    </script>
</body>
</html>



<!DOCTYPE html>
<html>
<head>
    <title>Fruit Farm - URK24CS1175</title>
</head>
<body>
    <h2>Fruit Farm - URK24CS1175</h2>
    Rows: <input type="text" id="rows"><br><br>
    Columns: <input type="text" id="columns"><br><br>
    <button onclick="grow()">Plant Garden</button>
    <div id="garden"></div>
    <script>
        function grow() {
            let rows = parseInt(document.getElementById("rows").value);
            let columns = parseInt(document.getElementById("columns").value);
            let fruits = ["c:\\Users\\jasfe\\Downloads\\apples-on-a-tree-branch (1).jpg", "c:\\Users\\jasfe\\Downloads\\shutterstock_2453997129.jpg"];
            let garden = "";
            for (let i = 0; i < rows; i++) {
