                let milky = parseInt($("#milkyQuantity").val()) || 0;
                let black = parseInt($("#blackQuantity").val()) || 0;

                let colorPrice = 350;
                let brownPrice = 220;
                let milkyPrice = 250;
                let blackPrice = 290;

                let colorTotal = color * colorPrice;
                let brownTotal = brown * brownPrice;
                let milkyTotal = milky * milkyPrice;
                let blackTotal = black * blackPrice;

                let total = colorTotal + brownTotal + milkyTotal + blackTotal;

