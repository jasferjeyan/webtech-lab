            $("#deleteBtn").click(function () {

                if (selectedRow === null) {
                    $("#message").text("Select an employee to remove.");
                    return;
                }

                $(selectedRow).remove();

                selectedRow = null;

                $("#empId").val("");
                $("#empName").val("");
                $("#department").val("");

                $("#message").text("Employee removed successfully.");

                updateDimensions();
            });


            // Clear Form
            $("#clearBtn").click(function () {

                $("#empId").val("");
                $("#empName").val("");
                $("#department").val("");

                $("#employeeTable tbody tr").removeClass("selected");

                selectedRow = null;

                $("#message").text("Form cleared.");
            });


            // Highlight Selected Employee
            $("#highlightBtn").click(function () {

                if (selectedRow === null) {
                    $("#message").text("Select an employee first.");
                    return;
                }

                $("#employeeTable tbody tr").removeClass("selected");

                $(selectedRow).addClass("selected");

                $("#message").text("Selected employee highlighted.");

            });


            // Change Information Panel Appearance
            $("#styleBtn").click(function () {

                $("#infoPanel").css({
                    "background": "#dbeafe",
                    "border": "3px solid #2563eb",
                    "border-radius": "20px",
                    "padding": "30px",
                    "box-shadow": "0 5px 20px rgba(37, 99, 235, 0.3)"
                });

                $("#message").text(
                    "Information panel appearance changed."
                );

            });


            // Display Table Dimensions
            $("#dimensionBtn").click(function () {

                updateDimensions();

            });


            function updateDimensions() {

                var width = $("#employeeTable").outerWidth();
                var height = $("#employeeTable").outerHeight();

                $("#dimensions").text(
                    "Table Dimensions: Width = " +
                    width +
                    "px, Height = " +
                    height +
                    "px"
                );

            }

        });

    </script>

</body>

</html>

