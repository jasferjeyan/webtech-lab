                <option value="meena">Meena</option>
                <option value="vijay">Vijay</option>

                <option value="sanjay">Sanjay</option>
                <option value="keerthi">Keerthi</option>
                <option value="manoj">Manoj</option>

            </select>

        </div>


        <div class="organization">

            <div class="project">

                <h2>Project: Smart Business System</h2>

                <div class="teams">

                    <div class="team">

                        <h3>Development Team</h3>

                        <ul class="employees">

                            <li class="employee" data-name="arun" data-senior="yes">
                                Arun - Senior Developer
                            </li>

                            <li class="employee" data-name="priya" data-senior="no">
                                Priya - Developer
                            </li>

                            <li class="employee" data-name="rahul" data-senior="no">
                                Rahul - Tester
                            </li>

                            <li class="employee" data-name="divya" data-senior="yes">
                                Divya - Senior Developer
                            </li>

                        </ul>

                    </div>


                    <div class="team">

                        <h3>Design Team</h3>

                        <ul class="employees">

                            <li class="employee" data-name="karthik" data-senior="yes">
                                Karthik - Senior UI Designer
                            </li>

                            <li class="employee" data-name="meena" data-senior="no">
                                Meena - UX Designer
                            </li>

                            <li class="employee" data-name="vijay" data-senior="no">
                                Vijay - Graphic Designer
                            </li>

                        </ul>

                    </div>


                    <div class="team">

                        <h3>Testing Team</h3>

                        <ul class="employees">

                            <li class="employee" data-name="sanjay" data-senior="yes">
                                Sanjay - Senior Tester
                            </li>

                            <li class="employee" data-name="keerthi" data-senior="no">
                                Keerthi - QA Engineer
                            </li>

                            <li class="employee" data-name="manoj" data-senior="no">
                                Manoj - Tester
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>


        <div class="buttons">

            <button id="parentTeam">
                Parent Team
            </button>

            <button id="ancestors">
                Show All Ancestor
            </button>

            <button id="projectEmployees">
                Show Project Employees
            </button>

            <button id="teammates">
                Show Teammates
            </button>

            <button id="senior">
                Show Senior Employees
            </button>

            <button id="reset">
                Reset
            </button>

        </div>


        <div id="result">

            <h2>Result</h2>

            <p>
                Select an employee and choose an operation.
            </p>

        </div>

    </div>


    <script>

        $(document).ready(function () {

            var selectedEmployee = null;


            // Select Employee
            $("#employeeSelect").change(function () {

                var name = $(this).val();

                $(".employee").removeClass("selected highlight");

                if (name === "") {

                    selectedEmployee = null;

                    $("#result").html(
                        "<h2>Result</h2>" +
                        "<p>Please select an employee.</p>"
                    );

                    return;
                }

                selectedEmployee = $('.employee[data-name="' + name + '"]');

                selectedEmployee.addClass("selected");

                $("#result").html(
                    "<h2>Selected Employee</h2>" +
                    "<p>" + selectedEmployee.text() + "</p>"
                );

            });


            // Parent Team
            $("#parentTeam").click(function () {

                if (selectedEmployee === null) {

                    showMessage();

                    return;
                }

                $(".team").css(
                    "border",
                    "2px solid #93c5fd"
                );

                var team = selectedEmployee.closest(".team");

                team.css(
                    "border",
                    "4px solid #f59e0b"
                );

                var teamName = team.children("h3").text();

                $("#result").html(
                    "<h2>Parent Team</h2>" +
                    "<p>" + teamName + "</p>"
                );

            });


            // Show All Ancestor
            $("#ancestors").click(function () {

                if (selectedEmployee === null) {

                    showMessage();

                    return;
                }

                var project = selectedEmployee
                    .parents(".project");

                var team = selectedEmployee
                    .closest(".team");

                $(".project").css(
                    "border",
                    "2px solid #2563eb"
                );

                $(".team").css(
                    "border",
                    "2px solid #93c5fd"
                );

                project.css(
                    "border",
                    "4px solid #7c3aed"
                );

                team.css(
                    "border",
                    "4px solid #f59e0b"
                );

                $("#result").html(
                    "<h2>All Ancestors</h2>" +
                    "<p>" +
                    "Employee → Team: " +
                    team.children("h3").text() +
                    "<br>" +
                    "Team → Project: " +
                    project.children("h2").text() +
                    "</p>"
                );

            });


            // Show Project Employees
            $("#projectEmployees").click(function () {

                if (selectedEmployee === null) {

                    showMessage();

                    return;
                }

                var project = selectedEmployee.closest(".project");

                var employees = project.find(".employee");

                $(".employee").removeClass("highlight");

                employees.addClass("highlight");

                $("#result").html(
                    "<h2>Project Employees</h2>" +
                    "<p>Total Employees: " +
                    employees.length +
                    "</p>"
                );

            });


            // Show Teammates
            $("#teammates").click(function () {

                if (selectedEmployee === null) {

                    showMessage();

                    return;
                }

                var teammates = selectedEmployee
                    .siblings(".employee");

                $(".employee").removeClass("highlight");

                teammates.addClass("highlight");

                selectedEmployee.addClass("selected");

                $("#result").html(
                    "<h2>Teammates</h2>" +
                    "<p>" +
                    "Number of teammates: " +
                    teammates.length +
                    "</p>"
                );

            });


            // Show Senior Employees
            $("#senior").click(function () {

                if (selectedEmployee === null) {

                    showMessage();

                    return;
                }

                var seniors = selectedEmployee
                    .closest(".project")
                    .find('.employee[data-senior="yes"]');

                $(".employee").removeClass("highlight");

                seniors.addClass("highlight");

                selectedEmployee.addClass("selected");

                $("#result").html(
                    "<h2>Senior Employees</h2>" +
                    "<p>Senior Employees in the project: " +
                    seniors.length +
                    "</p>"
                );

            });


            // Reset
            $("#reset").click(function () {

                $("#employeeSelect").val("");

                $(".employee").removeClass(
                    "selected highlight"
                );

                $(".team").css(
                    "border",
                    "2px solid #93c5fd"
                );

                $(".project").css(
                    "border",
                    "2px solid #2563eb"
                );

                selectedEmployee = null;

                $("#result").html(
                    "<h2>Result</h2>" +
                    "<p>Select an employee and choose an operation.</p>"
                );

            });


            function showMessage() {

                $("#result").html(
                    "<h2>Result</h2>" +
                    "<p>Please select an employee first.</p>"
                );

            }

        });

    </script>

</body>

</html>
