                    <div class="window window-left" id="window1"></div>

                    <div class="window window-right" id="window2"></div>

                    <div class="window-divider"></div>

                    <div class="car-body" id="carBody">
                        <div class="front"></div>
                        <div class="light"></div>
                    </div>

                    <div class="wheel wheel-left" id="wheel1"></div>

                    <div class="wheel wheel-right" id="wheel2"></div>

                </div>
            </div>

            <div class="controls">

                <div class="control-card">
                    <h3>Change Car Color</h3>

                    <div class="color-buttons">
                        <button class="color-btn blue" data-color="#2563eb"></button>
                        <button class="color-btn red" data-color="#dc2626"></button>
                        <button class="color-btn green" data-color="#16a34a"></button>
                        <button class="color-btn black" data-color="#111827"></button>
                        <button class="color-btn yellow" data-color="#eab308"></button>
                        <button class="color-btn white" data-color="#ffffff"></button>
                    </div>
                </div>

                <div class="control-card">
                    <h3>Change Glass Tint</h3>

                    <div class="glass-buttons">
                        <button class="glass-btn" data-glass="#bae6fd">Light</button>
                        <button class="glass-btn" data-glass="#64748b">Grey</button>
                        <button class="glass-btn" data-glass="#1e293b">Dark</button>
                        <button class="glass-btn" data-glass="#020617">Black</button>
                    </div>
