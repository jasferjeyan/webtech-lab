            /* 8. Stop */
            $("#stopBtn").click(function () {
                $("#productCard").stop();
            });

            /* 9. Callback */
            $("#callbackBtn").click(function () {

                $("#message").text("");

                $("#productCard").fadeOut(800, function () {

                    $("#message").text(
                        "Animation completed successfully"
                    );

                });

            });

            /* 10. Chaining */
            $("#chainBtn").click(function () {

                $("#message").text("");

                $("#productCard")
                    .slideUp(500)
                    .slideDown(500)
                    .fadeTo(500, 0.5)
                    .fadeTo(500, 1)
                    .animate({
                        width: "450px"
                    }, 500);

            });

        });
    </script>

