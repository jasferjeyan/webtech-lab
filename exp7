            </div>

            <button id="reset">Reset Car</button>

        </div>
    </div>

    <div class="footer">
        Practicum 7 | Working with jQuery
    </div>

</div>

<script>
$(document).ready(function() {

    $(".color-btn").click(function() {

        let color = $(this).data("color");

        $("#carBody").css("background-color", color);
        $("#roof").css("background-color", color);
        $(".front").css("background-color", color);

        $("#status").text(
            "Car color has been changed successfully."
        );
    });


    $(".glass-btn").click(function() {

        let glassColor = $(this).data("glass");

        $("#window1").css("background-color", glassColor);
        $("#window2").css("background-color", glassColor);

        $("#status").text(
            "Glass tint has been changed successfully."
        );
    });


    $(".tyre-btn").click(function() {

        let size = $(this).data("size");

        $("#wheel1").css({
            "width": size,
            "height": size
        });

        $("#wheel2").css({
            "width": size,
            "height": size
        });

        $("#status").text(
            "Tyre size has been changed successfully."
        );
    });


    $("#reset").click(function() {

        $("#carBody").css("background-color", "#2563eb");
        $("#roof").css("background-color", "#2563eb");
        $(".front").css("background-color", "#2563eb");

        $("#window1").css("background-color", "#bae6fd");
        $("#window2").css("background-color", "#bae6fd");

        $("#wheel1").css({
            "width": "80px",
            "height": "80px"
        });

        $("#wheel2").css({
            "width": "80px",
            "height": "80px"
        });

        $("#status").text(
            "Car has been reset to the original design."
        );
    });

});
</script>

</body>
</html>
