<!DOCTYPE html>
<html>
<head>
    <title>Digital Clock - URK24CS1175</title>
    <style>
        body {
            text-align: center;
            font-family: Arial, sans-serif;
            margin-top: 100px;
            background-color: #f0f2f5;
        }

        .clock-container {
            display: inline-block;
            background-color: #1e1e24;
            color: #ffffff;
            padding: 20px 40px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        #clock {
            font-size: 48px;
            font-weight: bold;
            font-family: 'Courier New', Courier, monospace;
            color: #00ffcc;
        }
    </style>
</head>
<body>
    <h1>Digital Clock - URK24CS1175</h1>
    
    <!-- Wrapped the clock div inside a colored container -->
    <div class="clock-container">
        <div id="clock"></div>
    </div>

    <script>
        function display() {
            var d = new Date();
            var h = String(d.getHours()).padStart(2, "0");
            var m = String(d.getMinutes()).padStart(2, "0");
            var s = String(d.getSeconds()).padStart(2, "0");
            document.getElementById("clock").innerHTML = 
                h + ":" + m + ":" + s;
        }
        display();
        setInterval(display, 1000);
    </script>
</body>
</html>



<!DOCTYPE html>
<html>
<head>
    <title>Dynamic Background - URK24CS1175</title>
</head>
<body>
    <h1>Dynamic Background Colour - URK24CS1175</h1>
    <p>The background colour changes every 5 seconds.</p>
    <script>
        function changeColor() {
            var red = Math.floor(Math.random() * 256);
            var green = Math.floor(Math.random() * 256);
            var blue = Math.floor(Math.random() * 256);
            var color = "rgb(" + red + "," + green + "," + blue + ")";
            document.body.style.backgroundColor = color;
        }
        changeColor();
        setInterval(changeColor, 5000);
    </script>
</body>
</html>


