<!DOCTYPE html>
<html>
<head>
    <title>Student Details - URK24CS1175</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #fcfcfc;
            margin: 0;
            padding: 40px;
            color: #333;
        }

        h1 {
            text-align: center;
            color: #1a1a1a;
            margin-bottom: 50px;
        }

        /* Displays cards in a clean grid layout */
        #students {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
        }

        /* Modern card layout replacing the heavy red border */
        .student-card {
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            padding: 24px;
            width: 280px;
            border-top: 5px solid #3a86ff; /* Blue accent line */
            text-align: left;
        }

        .student-name {
            font-size: 20px;
            font-weight: bold;
            color: #2c3e50;
            margin: 0 0 10px 0;
        }

        .student-info {
            font-size: 14px;
            margin: 6px 0;
            color: #7f8c8d;
        }

        /* Styling for the category labels */
        .badge {
            display: inline-block;
            margin-top: 15px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .before-2000 {
            /* Kept empty as per workspace placeholder */
        }

        .after-2000 {
            background-color: #e63946;
            color: white;
        }
    </style>
</head>
<body>
    <h1>Student Details - URK24CS1175</h1>
    <div id="students"></div>

    <script>
        var students = [
            { name: "John", regno: "URK21CS1102", dob: 1997 },
            { name: "Ram", regno: "URK24CS1175", dob: 2000 },
            { name: "David", regno: "URK23CS1166", dob: 2006 }
        ];

        var htmlContent = "";

        for (var i = 0; i < students.length; i++) {
            var student = students[i];
            var categoryText, badgeClass;

            // Setting different badge colors and text based on conditions
            if (student.dob < 2000) {
                categoryText = "Born before 2000";
                badgeClass = "before-2000";
            } else {
                categoryText = "Born after 2000";
                badgeClass = "after-2000";
            }

            // Using template literals for highly readable template building
            htmlContent += `
                <div class="student-card">
                    <p class="student-name">${student.name}</p>
                    <p class="student-info"><b>Register No:</b> ${student.regno}</p>
                    <p class="student-info"><b>Year of Birth:</b> ${student.dob}</p>
                    <span class="badge ${badgeClass}">${categoryText}</span>
                </div>
            `;
        }

        document.getElementById("students").innerHTML = htmlContent;
    </script>
</body>
</html>
